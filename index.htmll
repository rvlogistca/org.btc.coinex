<div class="aba">
  <button class="ativo" data-per="1h">1H</button>
  <button data-per="4h">4H</button>
  <button data-per="1d">1D</button>
  <button data-per="1w">1S</button>
  <button data-per="1m">1M</button>
</div>
<div id="chartContainer">
  <span class="status-webgpu" id="statusWebGPU">🔄 Iniciando WebGPU...</span>
  <canvas id="canvas"></canvas>
</div>
<script>
const CONTRATO_TOKEN = '0x4644E1113FE1a6bA831D85cc4772b3D0c23DE655';
const CARTEIRA_USUARIO = '0x26Ef6c3AF50240F211E774213914f8DB526fA77d';
const PRECO_BASE_USDT = 1.00;
let dadosVelas = [];
let dispositivo, contexto, formato, pipeline, bindGroupLayout;
let precoMin = PRECO_BASE_USDT, precoMax = PRECO_BASE_USDT;
async function inicializarWebGPU() {
  const statusEl = document.getElementById('statusWebGPU');
  const canvas = document.getElementById('canvas');
  if (!navigator.gpu) { statusEl.textContent = '❌ WebGPU indisponível'; statusEl.classList.add('indisponivel'); return false; }
  const adaptador = await navigator.gpu.requestAdapter();
  if (!adaptador) { statusEl.textContent = '❌ Sem GPU compatível'; statusEl.classList.add('indisponivel'); return false; }
  dispositivo = await adaptador.requestDevice();
  contexto = canvas.getContext('webgpu');
  formato = navigator.gpu.getPreferredCanvasFormat();
  contexto.configure({ device: dispositivo, format: formato, alphaMode: 'premultiplied' });
  const codigoShader = `
    struct Uniforms { precoMin: f32, precoMax: f32, padding: f32, padding2: f32 }
    @group(0) @binding(0) var<uniform> u: Uniforms;
    struct Vela { tempo: f32, aberto: f32, fechado: f32, maximo: f32, minimo: f32, volume: f32 }
    @group(0) @binding(1) var<storage, read> velas: array<Vela>;
    struct VertexOutput { @builtin(position) pos: vec4<f32>, @location(0) cor: vec3<f32> }
    @vertex fn vs_vela(@builtin(vertex_index) vi: u32, @builtin(instance_index) ii: u32) -> VertexOutput {
      let v = velas[ii];
      let precoRange = u.precoMax - u.precoMin;
      let x = (f32(ii) + 0.5) / f32(arrayCount(&velas)) * 2.0 - 1.0;
      let larguraVela = 1.5 / f32(arrayCount(&velas));
      let yAberto = 1.0 - ((v.aberto - u.precoMin) / precoRange) * 2.0;
      let yFechado = 1.0 - ((v.fechado - u.precoMin) / precoRange) * 2.0;
      let yMaximo = 1.0 - ((v.maximo - u.precoMin) / precoRange) * 2.0;
      let yMinimo = 1.0 - ((v.minimo - u.precoMin) / precoRange) * 2.0;
      let corpoTop = max(yAberto, yFechado);
      let corpoBase = min(yAberto, yFechado);
      let cor = select(vec3<f32>(0.031, 0.6, 0.505), vec3<f32>(0.949, 0.211, 0.270), v.fechado < v.aberto);
      var pos = vec4<f32>(0.0, 0.0, 0.0, 1.0);
      if vi == 0 { pos = vec4<f32>(x - larguraVela, corpoBase, 0.0, 1.0); }
      else if vi == 1 { pos = vec4<f32>(x + larguraVela, corpoBase, 0.0, 1.0); }
      else if vi == 2 { pos = vec4<f32>(x + larguraVela, corpoTop, 0.0, 1.0); }
      else if vi == 3 { pos = vec4<f32>(x - larguraVela, corpoTop, 0.0, 1.0); }
      else if vi == 4 { pos = vec4<f32>(x - 0.005, yMinimo, 0.0, 1.0); }
      else if vi == 5 { pos = vec4<f32>(x + 0.005, yMinimo, 0.0, 1.0); }
      else if vi == 6 { pos = vec4<f32>(x + 0.005, yMaximo, 0.0, 1.0); }
      else if vi == 7 { pos = vec4<f32>(x - 0.005, yMaximo, 0.0, 1.0); }
      var output: VertexOutput; output.pos = pos; output.cor = cor; return output;
    }
    @fragment fn fs_vela(input: VertexOutput) -> @location(0) vec4<f32> { return vec4<f32>(input.cor, 1.0); }
  `;
  const moduloShader = dispositivo.createShaderModule({ code: codigoShader });
  bindGroupLayout = dispositivo.createBindGroupLayout({
    entries: [{ binding: 0, visibility: GPUShaderStage.VERTEX, buffer: { type: 'uniform' } },{ binding: 1, visibility: GPUShaderStage.VERTEX, buffer: { type: 'read-only-storage' } }]
  });
  const layoutPipeline = dispositivo.createPipelineLayout({ bindGroupLayouts: [bindGroupLayout] });
  pipeline = dispositivo.createRenderPipeline({
    layout: layoutPipeline,
    vertex: { module: moduloShader, entryPoint: 'vs_vela' },
    fragment: { module: moduloShader, entryPoint: 'fs_vela', targets: [{ format: formato }] },
    primitive: { topology: 'triangle-strip' }
  });
  statusEl.textContent = '✅ WebGPU ativo';
  return true;
}
function gerarDadosVelas(periodo = '1d') {
  const agora = Math.floor(Date.now() / 1000);
  dadosVelas = [];
  let intervalo = 3600, qtd = 24;
  if (periodo === '4h') { intervalo = 14400; qtd = 12; }
  else if (periodo === '1d') { intervalo = 86400; qtd = 30; }
  else if (periodo === '1w') { intervalo = 604800; qtd = 12; }
  else if (periodo === '1m') { intervalo = 2592000; qtd = 6; }
  let preco = PRECO_BASE_USDT;
  precoMin = preco; precoMax = preco; let volTotal = 0;
  for (let i = qtd; i >= 0; i--) {
    const variacao = (Math.random() - 0.5) * 0.02;
    const abertura = preco;
    const fechado = preco * (1 + variacao);
    const maximo = Math.max(abertura, fechado) * (1 + Math.random() * 0.005);
    const minimo = Math.min(abertura, fechado) * (1 - Math.random() * 0.005);
    const volume = Math.random() * 100000 + 50000;
    dadosVelas.push({ tempo: agora - (i * intervalo), aberto: abertura, fechado, maximo, minimo, volume });
    preco = fechado;
    precoMin = Math.min(precoMin, minimo);
    precoMax = Math.max(precoMax, maximo);
    volTotal += volume;
  }
  const ultimo = dadosVelas[dadosVelas.length - 1];
  document.getElementById('precoAtual').textContent = ultimo.fechado.toFixed(6);
  document.getElementById('abertura').innerHTML = `<span class="usdt-valor">${ultimo.aberto.toFixed(6)} USDT</span>`;
  document.getElementById('maxima').innerHTML = `<span class="usdt-valor">${precoMax.toFixed(6)} USDT</span>`;
  document.getElementById('minima').innerHTML = `<span class="usdt-valor">${precoMin.toFixed(6)} USDT</span>`;
  document.getElementById('volume').innerHTML = `<span class="usdt-valor">${volTotal.toLocaleString('en-US', {minimumFractionDigits:2})} USDT</span>`;
  const varPct = ((ultimo.fechado - dadosVelas[0].aberto) / dadosVelas[0].aberto) * 100;
  const elVar = document.getElementById('variacao');
  elVar.innerHTML = `${varPct >= 0 ? '+' : ''}${varPct.toFixed(2)}%`;
  elVar.className = `variacao ${varPct < 0 ? 'vermelho' : ''}`;
  renderizarWebGPU();
}
function renderizarWebGPU() {
  if (!dispositivo || dadosVelas.length === 0) return;
  const canvas = document.getElementById('canvas');
  const container = document.getElementById('chartContainer');
  const dpr = window.devicePixelRatio || 1;
  canvas.width = container.clientWidth * dpr;
  canvas.height = container.clientHeight * dpr;
  const dadosVelaBuffer = new Float32Array(dadosVelas.length * 6);
  dadosVelas.forEach((v, i) => {
    dadosVelaBuffer[i * 6 + 0] = v.tempo;
    dadosVelaBuffer[i * 6 + 1] = v.aberto;
    dadosVelaBuffer[i * 6 + 2] = v.fechado;
    dadosVelaBuffer[i * 6 + 3] = v.maximo;
    dadosVelaBuffer[i * 6 + 4] = v.minimo;
    dadosVelaBuffer[i * 6 + 5] = v.volume;
  });
  const velaBuffer = dispositivo.createBuffer({ size: dadosVelaBuffer.byteLength, usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST });
  dispositivo.queue.writeBuffer(velaBuffer, 0, dadosVelaBuffer);
  const uniforms = new Float32Array([precoMin, precoMax, 0, 0]);
  const uniformBuffer = dispositivo.createBuffer({ size: uniforms.byteLength, usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST });
  dispositivo.queue.writeBuffer(uniformBuffer, 0, uniforms);
  const bindGroup = dispositivo.createBindGroup({ layout: bindGroupLayout, entries: [{ binding: 0, resource: { buffer: uniformBuffer } },{ binding: 1, resource: { buffer: velaBuffer } }] });
  const codificador = dispositivo.createCommandEncoder();
  const alvo = contexto.getCurrentTexture().createView();
  const pass = codificador.beginRenderPass({ colorAttachments: [{ view: alvo, loadOp: 'clear', clearValue: { r: 0.043, g: 0.055, b: 0.067, a: 1 }, storeOp: 'store' }] });
  pass.setPipeline(pipeline);
  pass.setBindGroup(0, bindGroup);
  for (let i = 0; i < dadosVelas.length; i++) { pass.draw(4, 1, 0, i); pass.draw(4, 1, 4, i); }
  pass.end();
  dispositivo.queue.submit([codificador.finish()]);
}
document.querySelectorAll('.aba button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.aba button').forEach(b => b.classList.remove('ativo'));
    btn.classList.add('ativo');
    gerarDadosVelas(btn.dataset.per);
  });
});
window.addEventListener('load', async () => { await inicializarWebGPU(); gerarDadosVelas('1d'); });
</script>
</body>
</html>      
      let yAberto = 1.0 - ((v.aberto - u.precoMin) / precoRange) * 2.0;
      let yFechado = 1.0 - ((v.fechado - u.precoMin) / precoRange) * 2.0;
      let yMaximo = 1.0 - ((v.maximo - u.precoMin) / precoRange) * 2.0;
      let yMinimo = 1.0 - ((v.minimo - u.precoMin) / precoRange) * 2.0;
      
      let corpoTop = max(yAberto, yFechado);
      let corpoBase = min(yAberto, yFechado);
      let cor = select(vec3<f32>(0.031, 0.6, 0.505), vec3<f32>(0.949, 0.211, 0.270), v.fechado < v.aberto);
      
      var pos = vec4<f32>(0.0, 0.0, 0.0, 1.0);
      if vi == 0 { pos = vec4<f32>(x - larguraVela, corpoBase, 0.0, 1.0); }
      else if vi == 1 { pos = vec4<f32>(x + larguraVela, corpoBase, 0.0, 1.0); }
      else if vi == 2 { pos = vec4<f32>(x + larguraVela, corpoTop, 0.0, 1.0); }
      else if vi == 3 { pos = vec4<f32>(x - larguraVela, corpoTop, 0.0, 1.0); }
      else if vi == 4 { pos = vec4<f32>(x - 0.005, yMinimo, 0.0, 1.0); }
      else if vi == 5 { pos = vec4<f32>(x + 0.005, yMinimo, 0.0, 1.0); }
      else if vi == 6 { pos = vec4<f32>(x + 0.005, yMaximo, 0.0, 1.0); }
      else if vi == 7 { pos = vec4<f32>(x - 0.005, yMaximo, 0.0, 1.0); }
      
      var output: VertexOutput;
      output.pos = pos;
      output.cor = cor;
      return output;
    }
    @fragment fn fs_vela(input: VertexOutput) -> @location(0) vec4<f32> { return vec4<f32>(input.cor, 1.0); }
  `;

  const moduloShader = dispositivo.createShaderModule({ code: codigoShader });
  bindGroupLayout = dispositivo.createBindGroupLayout({
    entries: [
      { binding: 0, visibility: GPUShaderStage.VERTEX, buffer: { type: 'uniform' } },
      { binding: 1, visibility: GPUShaderStage.VERTEX, buffer: { type: 'read-only-storage' } },
    ],
  });

  const layoutPipeline = dispositivo.createPipelineLayout({ bindGroupLayouts: [bindGroupLayout] });
  pipeline = dispositivo.createRenderPipeline({
    layout: layoutPipeline,
    vertex: { module: moduloShader, entryPoint: 'vs_vela' },
    fragment: { module: moduloShader, entryPoint: 'fs_vela', targets: [{ format: formato }] },
    primitive: { topology: 'triangle-strip' },
  });

  statusEl.textContent = '✅ WebGPU ativo';
  return true;
}

function gerarDadosVelas(periodo = '1d') {
  const agora = Math.floor(Date.now() / 1000);
  dadosVelas = [];
  let intervalo = 3600, qtd = 24;
  if (periodo === '4h') { intervalo = 14400; qtd = 12; }
  else if (periodo === '1d') { intervalo = 86400; qtd = 30; }
  else if (periodo === '1w') { intervalo = 604800; qtd = 12; }
  else if (periodo === '1m') { intervalo = 2592000; qtd = 6; }

  let preco = PRECO_BASE_USDT;
  precoMin = preco; precoMax = preco; let volTotal = 0;

  for (let i = qtd; i >= 0; i--) {
    const variacao = (Math.random() - 0.5) * 0.02;
    const abertura = preco;
    const fechado = preco * (1 + variacao);
    const maximo = Math.max(abertura, fechado) * (1 + Math.random() * 0.005);
    const minimo = Math.min(abertura, fechado) * (1 - Math.random() * 0.005);
    const volume = Math.random() * 100000 + 50000;

    dadosVelas.push({ tempo: agora - (i * intervalo), aberto: abertura, fechado, maximo, minimo, volume });
    preco = fechado;
    precoMin = Math.min(precoMin, minimo);
    precoMax = Math.max(precoMax, maximo);
    volTotal += volume;
  }

  const ultimo = dadosVelas[dadosVelas.length - 1];
  document.getElementById('precoAtual').textContent = ultimo.fechado.toFixed(6);
  document.getElementById('abertura').innerHTML = `<span class="usdt-valor">${ultimo.aberto.toFixed(6)} USDT</span>`;
  document.getElementById('maxima').innerHTML = `<span class="usdt-valor">${precoMax.toFixed(6)} USDT</span>`;
  document.getElementById('minima').innerHTML = `<span class="usdt-valor">${precoMin.toFixed(6)} USDT</span>`;
  document.getElementById('volume').innerHTML = `<span class="usdt-valor">${volTotal.toLocaleString('en-US', {minimumFractionDigits:2})} USDT</span>`;
  
  const varPct = ((ultimo.fechado - dadosVelas[0].aberto) / dadosVelas[0].aberto) * 100;
  const elVar = document.getElementById('variacao');
  elVar.innerHTML = `${varPct >= 0 ? '+' : ''}${varPct.toFixed(2)}%`;
  elVar.className = `variacao ${varPct < 0 ? 'vermelho' : ''}`;

  renderizarWebGPU();
}

function renderizarWebGPU() {
  if (!dispositivo || dadosVelas.length === 0) return;
  const canvas = document.getElementById('canvas');
  const container = document.getElementById('chartContainer');
  const dpr = window.devicePixelRatio || 1;
  canvas.width = container.clientWidth * dpr;
  canvas.height = container.clientHeight * dpr;

  const dadosVelaBuffer = new Float32Array(dadosVelas.length * 6);
  dadosVelas.forEach((v, i) => {
    dadosVelaBuffer[i * 6 + 0] = v.tempo;
    dadosVelaBuffer[i * 6 + 1] = v.aberto;
    dadosVelaBuffer[i * 6 + 2] = v.fechado;
    dadosVelaBuffer[i * 6 + 3] = v.maximo;
    dadosVelaBuffer[i * 6 + 4] = v.minimo;
    dadosVelaBuffer[i * 6 + 5] = v.volume;
  });

  const velaBuffer = dispositivo.createBuffer({
    size: dadosVelaBuffer.byteLength,
    usage: GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST,
  });
  dispositivo.queue.writeBuffer(velaBuffer, 0, dadosVelaBuffer);

  const uniforms = new Float32Array([precoMin, precoMax, 0, 0]);
  const uniformBuffer = dispositivo.createBuffer({
    size: uniforms.byteLength,
    usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST,
  });
  dispositivo.queue.writeBuffer(uniformBuffer, 0, uniforms);

  const bindGroup = dispositivo.createBindGroup({
    layout: bindGroupLayout,
    entries: [
      { binding: 0, resource: { buffer: uniformBuffer } },
      { binding: 1, resource: { buffer: velaBuffer } },
    ],
  });

  const codificador = dispositivo.createCommandEncoder();
  const alvo = contexto.getCurrentTexture().createView();
  const pass = codificador.beginRenderPass({
    colorAttachments: [{
      view: alvo,
      loadOp: 'clear',
      clearValue: { r: 0.043, g: 0.055, b: 0.067, a: 1 },
      storeOp: 'store',
    }],
  });

  pass.setPipeline(pipeline);
  pass.setBindGroup(0, bindGroup);
  for (let i = 0; i < dadosVelas.length; i++) {
    pass.draw(4, 1, 0, i);
    pass.draw(4, 1, 4, i);
  }
  pass.end();

  dispositivo.queue.submit([codificador.finish()]);
}

document.querySelectorAll('.aba button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.aba button').forEach(b => b.classList.remove('ativo'));
    btn.classList.add('ativo');
    gerarDadosVelas(btn.dataset.per);
  });
});

window.addEventListener('load', async () => {
  await inicializarWebGPU();
  gerarDadosVelas('1d');
});
</script>
</body>
</html>
