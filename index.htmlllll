<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crypto Coinnex · Em Manutenção</title>
  <script src="https://cdn.tailwindcss.com"></script> >< foto.png ><
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');
    * { font-family:'Inter',sans-serif; box-sizing:border-box; }
    :root{--ouro:#ffd700;--ouro-escuro:#b8860b;--verde:#22c55e;--fundo:#0a0800;--card:#1a1500}
    html{scroll-behavior:smooth}
    body{
      background:var(--fundo);color:#fff;min-height:100vh;
      background-image:radial-gradient(circle at top,rgba(255,215,0,.12),transparent 50%),radial-gradient(circle at bottom,rgba(34,197,94,.08),transparent 50%);
    }
    .texto-dourado{background:linear-gradient(135deg,#ffd700,#ffec80,#ffd700);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:900}
    .texto-verde{background:linear-gradient(135deg,#22c55e,#86efac,#22c55e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:900}
    .card-manutencao{
      background:linear-gradient(135deg,#1a1500,#0f2e1a);
      border:2px solid var(--ouro);
      box-shadow:0 0 40px rgba(255,215,0,.2), 0 0 60px rgba(34,197,94,.15);
      border-radius:24px;
      animation:pulse 2s infinite alternate;
    }
    @keyframes pulse{
      from{box-shadow:0 0 40px rgba(255,215,0,.2), 0 0 60px rgba(34,197,94,.15)}
      to{box-shadow:0 0 55px rgba(255,215,0,.35), 0 0 80px rgba(34,197,94,.25)}
    }
    .icone-manutencao{font-size:60px;animation:giro 3s linear infinite}
    @keyframes giro{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
    .barra-progresso{
      height:8px;border-radius:4px;background:#2a2510;overflow:hidden;margin-top:20px
    }
    .barra-progresso>span{
      display:block;height:100%;border-radius:4px;
      background:linear-gradient(90deg,#ffd700,#22c55e);
      width:65%;
      animation:carregar 2s ease-in-out infinite alternate
    }
    @keyframes carregar{from{width:55%}to{width:75%}}
  </style>
</head>
<body class="flex items-center justify-center min-h-screen px-4 py-8">

  <!-- TELA DE MANUTENÇÃO -->
  <div class="card-manutencao p-8 md:p-12 max-w-lg w-full text-center">
    <div class="icone-manutencao mb-6">⚙️</div>
    
    <h1 class="text-3xl md:text-4xl font-black mb-3 texto-dourado">Crypto Coinnex</h1>
    <h2 class="text-xl md:text-2xl font-bold mb-6 texto-verde">Sistema em Manutenção</h2>
    
    <p class="text-lg text-yellow-100 mb-4">Estamos trabalhando para melhorar sua experiência</p>
    
    <div class="bg-black/40 rounded-xl p-5 mb-6 border border-yellow-600/30">
      <p class="text-sm text-yellow-300/80 mb-2">🔧 Atualização de segurança e performance</p>
      <p class="text-xs text-yellow-200/60">Fundo de Desenvolvimento do Projeto Crédito Carbono</p>
      
      <div class="barra-progresso">
        <span></span>
      </div>
      <p class="text-xs text-yellow-300/70 mt-2">Concluído: ~65%</p>
    </div>

    <div class="space-y-3 text-left bg-black/30 rounded-xl p-4 border border-green-700/30 mb-6">
      <p class="text-sm text-green-300 font-semibold">🌿 O que estamos implementando:</p>
      <ul class="text-xs text-yellow-100/80 space-y-2 pl-4 list-disc">
        <li>Verificação oficial na blockchain Ethereum</li>
        <li>Integração Binance Web3 Wallet</li>
        <li>Exibição em tempo real dos saldos BTC e USDT</li>
        <li>Relatórios de crédito de carbono</li>
        <li>Certificação de segurança da plataforma</li>
      </ul>
    </div>

    <p class="text-sm text-yellow-200/70 mb-4">⏳ Retorno previsto: em breve</p>
    
    <div class="text-xs text-yellow-300/60 border-t border-yellow-700/30 pt-4">
      <p>🎖️ Floyd Menezes · Diretor da Companhia</p>
      <p class="mt-1">© 2026 Crypto Coinnex — Todos os direitos reservados</p>
    </div>
  </div>

</body>
</html>
